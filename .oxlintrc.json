{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "node", "unicorn", "oxc", "promise", "eslint"],
  "options": {
    "typeCheck": true,
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "import/first": "error",
    "no-console": "off",
    "no-await-in-loop": "off",
    // Boundary convention (see AGENTS.md): gh/claude JSON.parse results are
    // narrowed by assertion at the parse site, nowhere else.
    "typescript/no-unsafe-type-assertion": "off",
    // bun:test types mark `.rejects` matchers as sync, but the runtime returns
    // a promise that MUST be awaited — removing the await would break the tests.
    "typescript/await-thenable": "off"
  },
  "ignorePatterns": ["node_modules", ".runs", "docs", "ui", ".agents", ".claude"]
}
