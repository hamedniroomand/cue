{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "node", "unicorn", "oxc", "promise", "eslint"],
  "options": {
    "typeCheck": true,
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "import/first": "error",
    // consola is the sanctioned logger (see AGENTS.md); console.error stays
    // allowed as the last-resort sink for main()'s catch-all.
    "no-console": ["error", { "allow": ["error"] }],
    "no-await-in-loop": "off",
    // Boundary convention (see AGENTS.md): gh/claude JSON.parse results are
    // narrowed by assertion at the parse site, nowhere else.
    "typescript/no-unsafe-type-assertion": "off",
    // bun:test types mark `.rejects` matchers as sync, but the runtime returns
    // a promise that MUST be awaited — removing the await would break the tests.
    "typescript/await-thenable": "off",
    // Locks in the @ alias migration: no new '../' imports across module boundaries.
    "import/no-relative-parent-imports": "error",
    "max-classes-per-file": ["error", 2],
    "max-dependencies": ["error", 15],
    "typescript/no-invalid-void-type": "error"
  },
  "overrides": [
    {
      "files": ["src/embedded.ts"],
      "rules": {
        // The only file that reaches outside src/: embeds the root package.json
        // and prompts/ directory, both outside the @ alias's reach.
        "import/no-relative-parent-imports": "off"
      }
    },
    {
      "files": ["src/cli.ts"],
      "rules": {
        // Composition root: wires every module into the StageContext, so it
        // naturally imports more than the rest of the codebase.
        "max-dependencies": "off"
      }
    },
    {
      "files": ["scripts/**/*.ts"],
      "rules": {
        // Build tooling prints plain progress to a human's terminal, not through consola.
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules", ".runs", "docs", "ui", ".agents", ".claude"]
}
