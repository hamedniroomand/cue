{
  "name": "cue-agent",
  "version": "0.8.0",
  "description": "Deterministic runner that drives headless coding agents through a GitHub-issue pipeline: triage, human plan approval, dev, test gate, review loop, draft PR.",
  "keywords": [
    "ai-agent",
    "automation",
    "bun",
    "claude-code",
    "cli",
    "codex",
    "coding-agent",
    "github",
    "pull-request"
  ],
  "homepage": "https://hamedniroomand.github.io/cue/",
  "bugs": {
    "url": "https://github.com/hamedniroomand/cue/issues"
  },
  "license": "MIT",
  "author": "Hamed Niroomand",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamedniroomand/cue.git"
  },
  "bin": {
    "cue": "src/cli.ts"
  },
  "files": [
    "src",
    "tsconfig.json",
    "prompts",
    "ui/build/client"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cue": "bun run src/cli.ts",
    "test": "bun test",
    "ui:dev": "bun run --cwd ui dev",
    "ui:build": "bun run --cwd ui build",
    "ui:check": "bun run --cwd ui typecheck",
    "ui:lint": "bun run --cwd ui lint",
    "ui:format": "bun run --cwd ui format",
    "fixtures": "bun run scripts/fixtures.ts",
    "lint": "oxlint --disable-nested-config",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --disable-nested-config --check",
    "check": "bun run lint && bun run format:check && bun test --coverage",
    "check:no-cov": "bun run lint && bun run format:check && bun test",
    "prepublishOnly": "bun run ui:build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "consola": "^3.4.2",
    "ora": "^9.4.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "mermaid": "^12.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "vitepress": "^2.0.0-alpha.19",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.4.2"
}
