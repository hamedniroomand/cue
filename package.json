{
  "name": "conductor",
  "version": "0.2.0",
  "license": "MIT",
  "bin": {
    "conductor": "./src/cli.ts"
  },
  "files": [
    "src",
    "prompts",
    "ui/build/client"
  ],
  "type": "module",
  "scripts": {
    "conductor": "bun run src/cli.ts",
    "test": "bun test",
    "ui:dev": "bun run --cwd ui dev",
    "ui:build": "bun run --cwd ui build",
    "ui:check": "bun run --cwd ui typecheck",
    "ui:lint": "bun run --cwd ui lint",
    "ui:format": "bun run --cwd ui format",
    "fixtures": "bun run scripts/fixtures.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run lint && bun run format:check && bun test"
  },
  "dependencies": {
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0"
  }
}
